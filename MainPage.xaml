<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LetyAccesoriosApp.MainPage"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- ENCABEZADO -->
        <VerticalStackLayout Grid.Row="0" Margin="0,20,0,10" HorizontalOptions="Center">
            <Label Text="Lety ♡" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="Accesorios" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="{StaticResource TextPrimary}" 
                   Margin="0,-8,0,0"/>
        </VerticalStackLayout>

        <!-- CONTENIDO PRINCIPAL CON SCROLL -->
        <ScrollView Grid.Row="1" Padding="20,10">
            <VerticalStackLayout Spacing="20">
                
                <!-- TARJETAS DE NAVEGACIÓN PRINCIPALES (2x2) -->
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">
                    
                    <!-- INSUMOS -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource InsumosBlue}"
                            HeightRequest="140">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToInsumosCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                            <Label Text="INSUMOS" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="Inventario y&#10;Alertas" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- PRODUCTOS -->
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource ProductosPink}"
                            HeightRequest="140">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToProductosCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                            <Label Text="PRODUCTOS" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="Catálogo y&#10;Stock" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- VENTAS -->
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource VentasOrange}"
                            HeightRequest="140">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToVentasCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                            <Label Text="VENTAS" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="Registra&#10;Pedidos" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- RESUMEN -->
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource ResumenPurple}"
                            HeightRequest="140">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToResumenCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                            <Label Text="RESUMEN" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="Reportes y&#10;Ganancias" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- ÚLTIMAS ALERTAS -->
                <Border StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource CardBackground}"
                        Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Últimas Alertas" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}"/>
                        
                        <HorizontalStackLayout Spacing="10">
                            <!-- Alerta 1 -->
                            <Border StrokeShape="RoundRectangle 15"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource AlertPillBg}"
                                    Padding="10,5">
                                <Label Text="Cordón Rosa (2m)" FontSize="12" TextColor="{StaticResource AlertPillText}"/>
                            </Border>

                            <!-- Alerta 2 -->
                            <Border StrokeShape="RoundRectangle 15"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource AlertPillBg}"
                                    Padding="10,5">
                                <Label Text="Argollas Oro (10u)" FontSize="12" TextColor="{StaticResource AlertPillText}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA INFERIOR DE NAVEGACIÓN -->
        <Border Grid.Row="2" 
                StrokeShape="RoundRectangle 0" 
                StrokeThickness="0"
                BackgroundColor="{StaticResource CardBackground}" 
                Padding="10,5">
            <Grid ColumnDefinitions="*, *, *, *, *">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Label Text="Inicio" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <Label Text="Insumos" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Label Text="Productos" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                    <Label Text="Ventas" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="2">
                    <Label Text="Perfil" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>