<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LetyAccesoriosApp.Views.InsumosPage"
             BackgroundColor="#FFF3EB"
             Title="Inventario Insumos">

    <!-- Contenedor general en rejilla para fijar los encabezados y permitir el scroll en los datos -->
    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">
        
        <!-- ELEMENTO 1: ENCABEZADO Y FILTROS SUPERIORES (FOTO 2) -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Insumos / Inventario - Gestión 🧵" FontSize="20" FontAttributes="Bold" TextColor="#2D2D2D"/>
            <HorizontalStackLayout Grid.Column="1" Spacing="10">
                <Entry Placeholder="🔍 Filtrar Insumos..." WidthRequest="220" BackgroundColor="White"/>
                <Picker Title="Categoría" WidthRequest="130" BackgroundColor="White"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- ELEMENTO 2: ENCABEZADOS FIJOS DE LA TABLA ESTILO EXCEL REFINADO -->
        <Grid Grid.Row="1" BackgroundColor="#FCECE3" Padding="12,10" ColumnDefinitions="2.5*, *, *, 1.8*, Auto" Margin="0,5,0,0">
            <Label Grid.Column="0" Text="Insumo Name" FontAttributes="Bold" TextColor="#444444"/>
            <Label Grid.Column="1" Text="Precio (Costo)" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#444444"/>
            <Label Grid.Column="2" Text="Stock" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#444444"/>
            <Label Grid.Column="3" Text="Mejor Distribuidora" FontAttributes="Bold" TextColor="#444444"/>
            <Label Grid.Column="4" Text="Acciones" FontAttributes="Bold" WidthRequest="90" HorizontalOptions="Center" TextColor="#444444"/>
        </Grid>
        <!-- ELEMENTO 3: FILAS DINÁMICAS DE LA TABLA ESTILO EXCEL CONECTADAS A SQLITE -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Insumos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 0" Padding="12,10" Margin="0,1">
                        <Grid ColumnDefinitions="2.5*, *, *, 1.8*, Auto">
                            <!-- Nombre del Material -->
                            <Label Grid.Column="0" Text="{Binding Nombre}" VerticalOptions="Center" FontAttributes="Bold" TextColor="#2D2D2D"/>
                            
                            <!-- Costo Unitario -->
                            <Label Grid.Column="1" Text="{Binding PrecioCompra, StringFormat='${0:F2}/u'}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#2D2D2D"/>
                            
                            <!-- Cantidad en Inventario -->
                            <Label Grid.Column="2" Text="{Binding Stock, StringFormat='{0}u'}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#2D2D2D"/>
                            
                            <!-- Distribuidor o Tienda de Suministro -->
                            <Label Grid.Column="3" Text="{Binding NombreSucursal}" VerticalOptions="Center" TextColor="DimGray" FontSize="13"/>
                            
                            <!-- Botones Rápidos de Acción (Modificar / Eliminar) -->
                            <HorizontalStackLayout Grid.Column="4" Spacing="6" WidthRequest="90" HorizontalOptions="Center">
                                <Button Text="✏️" FontSize="12" WidthRequest="40" HeightRequest="32" Padding="0" BackgroundColor="#E2F0D9" TextColor="Black"/>
                                <Button Text="🗑️" FontSize="12" WidthRequest="40" HeightRequest="32" Padding="0" BackgroundColor="#FCECE3" TextColor="DarkRed"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
