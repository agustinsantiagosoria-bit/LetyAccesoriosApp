<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LetyAccesoriosApp.Views.InsumosPage"
             BackgroundColor="#FFF3EB"
             Title="Gestión de Insumos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Registrar Sucursal/Tienda" FontAttributes="Bold" FontSize="16" TextColor="#2D2D2D"/>
            <Entry Placeholder="Nombre de la tienda (ej. Once, Centro)" Text="{Binding NombreNuevaSucursal}" BackgroundColor="White"/>
            <Button Text="Agregar Tienda" Command="{Binding GuardarSucursalCommand}" BackgroundColor="#FCE4C8" TextColor="Black"/>

            <Label Text="Cargar Nuevo Insumo" FontAttributes="Bold" FontSize="16" TextColor="#2D2D2D"/>
            <Entry Placeholder="Ej. Cordón Elástico" Text="{Binding NombreInsumo}" BackgroundColor="White"/>
            <Entry Placeholder="Stock Inicial" Keyboard="Numeric" Text="{Binding StockInsumo}" BackgroundColor="White"/>
            <Entry Placeholder="Precio" Keyboard="Numeric" Text="{Binding PrecioInsumo}" BackgroundColor="White"/>
            
            <Picker Title="Seleccionar Sucursal" 
                    ItemsSource="{Binding Sucursales}" 
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding SucursalSeleccionada}"
                    BackgroundColor="White"/>

            <Button Text="Guardar Insumo" Command="{Binding GuardarInsumoCommand}" BackgroundColor="#B3D1F2" TextColor="Black"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
