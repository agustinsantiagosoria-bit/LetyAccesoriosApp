<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LetyAccesoriosApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LetyAccesoriosApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Lety Accesorios">

    <!-- Navegación directa y segura vinculando correctamente el prefijo views -->
        <TabBar>
        <!-- La primera pestaña es el Dashboard (Foto 1), por lo que la app arrancará aquí -->
        <Tab Title="Resumen General">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        </Tab>
        
        <Tab Title="Inventario Insumos">
            <ShellContent ContentTemplate="{DataTemplate views:InsumosPage}" Route="InsumosPage" />
        </Tab>
        
        <Tab Title="Catálogo Productos">
            <ShellContent ContentTemplate="{DataTemplate views:ProductoFormPage}" Route="ProductoFormPage" />
        </Tab>
        
        <Tab Title="Caja Registradora">
            <ShellContent ContentTemplate="{DataTemplate views:VentasPage}" Route="VentasPage" />
        </Tab>
    </TabBar>

</Shell>
